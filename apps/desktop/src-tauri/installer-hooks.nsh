  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".bmp" "Image"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".bmp" ""
  WriteRegStr HKCU "Software\Classes\.ico\OpenWithProgids" "Image" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".ico" "Image"
