  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".toml" ""
  WriteRegStr HKCU "Software\Classes\.xml\OpenWithProgids" "Text Document" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".xml" "Text Document"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".xml" ""
  WriteRegStr HKCU "Software\Classes\.log\OpenWithProgids" "Text Document" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".log" "Text Document"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".log" ""
  WriteRegStr HKCU "Software\Classes\.ini\OpenWithProgids" "Text Document" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".ini" "Text Document"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".ini" ""
  WriteRegStr HKCU "Software\Classes\.txt\OpenWithProgids" "Text Document" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".txt" "Text Document"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".txt" ""
  WriteRegStr HKCU "Software\Classes\.mp4\OpenWithProgids" "Media File" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".mp4" "Media File"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".mp4" ""
  WriteRegStr HKCU "Software\Classes\.webm\OpenWithProgids" "Media File" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".webm" "Media File"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".webm" ""
  WriteRegStr HKCU "Software\Classes\.mp3\OpenWithProgids" "Media File" ""
