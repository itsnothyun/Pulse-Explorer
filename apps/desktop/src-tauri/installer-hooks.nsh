  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".tar" ""
  WriteRegStr HKCU "Software\Classes\.gz\OpenWithProgids" "Archive" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".gz" "Archive"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".gz" ""
  WriteRegStr HKCU "Software\Classes\.tgz\OpenWithProgids" "Archive" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".tgz" "Archive"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".tgz" ""
  ; Pulse document icons per file type (pixel page + type label)
  WriteRegStr HKCU "Software\Classes\PDF Document\DefaultIcon" "" "$INSTDIR\filetype-icons\pdf.ico"
  WriteRegStr HKCU "Software\Classes\Document\DefaultIcon" "" "$INSTDIR\filetype-icons\doc.ico"
  WriteRegStr HKCU "Software\Classes\Presentation\DefaultIcon" "" "$INSTDIR\filetype-icons\slides.ico"
  WriteRegStr HKCU "Software\Classes\Spreadsheet\DefaultIcon" "" "$INSTDIR\filetype-icons\sheet.ico"
  WriteRegStr HKCU "Software\Classes\eBook\DefaultIcon" "" "$INSTDIR\filetype-icons\ebook.ico"
  WriteRegStr HKCU "Software\Classes\Image\DefaultIcon" "" "$INSTDIR\filetype-icons\image.ico"
  WriteRegStr HKCU "Software\Classes\Text Document\DefaultIcon" "" "$INSTDIR\filetype-icons\text.ico"
  WriteRegStr HKCU "Software\Classes\Media File\DefaultIcon" "" "$INSTDIR\filetype-icons\media.ico"
  WriteRegStr HKCU "Software\Classes\Archive\DefaultIcon" "" "$INSTDIR\filetype-icons\archive.ico"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
  nsExec::Exec 'ie4uinit.exe -show'
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  DeleteRegValue HKCU "Software\Classes\.pdf\OpenWithProgids" "PDF Document"
  DeleteRegValue HKCU "Software\Classes\.docx\OpenWithProgids" "Document"
  DeleteRegValue HKCU "Software\Classes\.doc\OpenWithProgids" "Document"
  DeleteRegValue HKCU "Software\Classes\.odt\OpenWithProgids" "Document"
  DeleteRegValue HKCU "Software\Classes\.rtf\OpenWithProgids" "Document"
  DeleteRegValue HKCU "Software\Classes\.pptx\OpenWithProgids" "Presentation"
  DeleteRegValue HKCU "Software\Classes\.ppt\OpenWithProgids" "Presentation"
  DeleteRegValue HKCU "Software\Classes\.odp\OpenWithProgids" "Presentation"
  DeleteRegValue HKCU "Software\Classes\.xlsx\OpenWithProgids" "Spreadsheet"
  DeleteRegValue HKCU "Software\Classes\.xls\OpenWithProgids" "Spreadsheet"
  DeleteRegValue HKCU "Software\Classes\.ods\OpenWithProgids" "Spreadsheet"
  DeleteRegValue HKCU "Software\Classes\.csv\OpenWithProgids" "Spreadsheet"
  DeleteRegValue HKCU "Software\Classes\.tsv\OpenWithProgids" "Spreadsheet"
  DeleteRegValue HKCU "Software\Classes\.epub\OpenWithProgids" "eBook"
  DeleteRegValue HKCU "Software\Classes\.fb2\OpenWithProgids" "eBook"
  DeleteRegValue HKCU "Software\Classes\.png\OpenWithProgids" "Image"
