  DeleteRegValue HKCU "Software\Classes\.mp3\OpenWithProgids" "Media File"
  DeleteRegValue HKCU "Software\Classes\.wav\OpenWithProgids" "Media File"
  DeleteRegValue HKCU "Software\Classes\.flac\OpenWithProgids" "Media File"
  DeleteRegValue HKCU "Software\Classes\.ogg\OpenWithProgids" "Media File"
  DeleteRegValue HKCU "Software\Classes\.aac\OpenWithProgids" "Media File"
  DeleteRegValue HKCU "Software\Classes\.zip\OpenWithProgids" "Archive"
  DeleteRegValue HKCU "Software\Classes\.tar\OpenWithProgids" "Archive"
  DeleteRegValue HKCU "Software\Classes\.gz\OpenWithProgids" "Archive"
  DeleteRegValue HKCU "Software\Classes\.tgz\OpenWithProgids" "Archive"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Pulse Explorer"
  DeleteRegKey HKCU "Software\PulseExplorer\Capabilities"
  DeleteRegKey HKCU "Software\Classes\Applications\PulseExplorer.exe"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
