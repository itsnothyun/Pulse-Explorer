; Registers Pulse Explorer in Explorer's "Open with" menu and in Settings > Default apps.
; Generated from tauri.conf.json fileAssociations; Tauri's own installer writes the ProgIDs.
!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities" "ApplicationName" "Pulse Explorer"
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities" "ApplicationDescription" "Universal local-first file viewer"
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities" "ApplicationIcon" "$INSTDIR\PulseExplorer.exe,0"
  WriteRegStr HKCU "Software\RegisteredApplications" "Pulse Explorer" "Software\PulseExplorer\Capabilities"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe" "FriendlyAppName" "Pulse Explorer"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\shell\open\command" "" '"$INSTDIR\PulseExplorer.exe" "%1"'
  WriteRegStr HKCU "Software\Classes\.pdf\OpenWithProgids" "PDF Document" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".pdf" "PDF Document"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".pdf" ""
  WriteRegStr HKCU "Software\Classes\.docx\OpenWithProgids" "Document" ""
  WriteRegStr HKCU "Software\PulseExplorer\Capabilities\FileAssociations" ".docx" "Document"
  WriteRegStr HKCU "Software\Classes\Applications\PulseExplorer.exe\SupportedTypes" ".docx" ""
